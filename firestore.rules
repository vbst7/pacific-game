rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the Pacific lobby system
    match /lobbies/{lobbyId} {
      // Anyone can create a lobby or read its status
      allow read, create: if true;
      
      // Allow game flow updates (starting the game, logging actions, advancing phases)
      // Note: Strict "Host Only" enforcement requires Firebase Auth (request.auth)
      allow update: if true;

      match /players/{playerId} {
        // Anyone can join a lobby, update their turn state, or resign (delete themselves)
        allow read, create, update, delete: if true;
      }
    }
  }
}